# Server
PORT=3000

# Claude API (Anthropic) - dung de sinh cau tra loi
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Zalo Official Account (OA) - lay tu https://oa.zalo.me sau khi tao OA va App
ZALO_OA_ID=
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
# Secret dung de xac thuc chu ky webhook (Zalo goi la "OA Secret Key" trong phan Webhook cua OA)
ZALO_OA_WEBHOOK_SECRET=

# Ten/alias de kich hoat tro ly khi duoc nhac den trong group chat, cach nhau boi dau phay
ASSISTANT_TRIGGER_NAMES=Bé Tiền,be tien,bé tiền,Be Tien
